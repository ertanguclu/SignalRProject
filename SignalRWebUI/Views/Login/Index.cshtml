@model LoginDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <title>Restoran Giriş Sayfası</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/colorlib-regform-32/css/login.css" rel="stylesheet">
</head>

<body>

    <div class="login-container">

        <h3 class="login-title">🍕 Restoran Giriş</h3>

        <form method="post">

            <div class="mb-3 input-group">

                <span class="input-group-text">👤</span>

                <input type="text" asp-for="Username"
                       class="form-control"
                       placeholder="Kullanıcı Adı">

            </div>

            <div class="mb-4 input-group">

                <span class="input-group-text">🔒</span>

                <input type="password"
                       asp-for="Password"
                       class="form-control"
                       placeholder="Şifre">

            </div>

            <div class="d-grid">

                <button class="btn btn-login text-white">
                    Giriş Yap
                </button>

            </div>

        </form>

    </div>

</body>
</html>