@model CreateMailDto
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Mail Sayfası</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Mail Gönderme Paneli</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="receivermail">Alıcı Mail Adresi</label>
								<input type="text" class="form-control" asp-for="ReceiverMail" id="receivermail">
							</div>
							<div class="form-group">
								<label for="subject">Konu</label>
								<input type="text" class="form-control" asp-for="Subject" id="subject">
							</div>
							<div class="form-group">
								<label for="body">Mesajınız</label>
                                <textarea class="form-control" asp-for="Body" id="body" rows="5"></textarea>
							</div>
							<div class="card-action">
								<button class="btn btn-outline-primary btn-round">Maili Gönder</button>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>


